{
  "name": "tcg-eu-index-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "data:export": "node scripts/export-static-data.mjs",
    "data:validate": "node scripts/validate-static-data.mjs",
    "reports:generate": "node scripts/generate-weekly-report.mjs",
    "reports:charts": "node scripts/generate-report-charts.mjs",
    "predev": "npm run data:export && npm run data:validate",
    "dev": "next dev",
    "prebuild": "npm run data:export && npm run data:validate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck:worker": "wrangler types && tsc --project tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^2.12.7",
    "vinext": "^1.0.0-beta.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "type": "module"
}
