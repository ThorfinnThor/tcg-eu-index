{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcg-eu-index-web",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://tcg-eu-index-web.shuu9599.workers.dev"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "NEWSLETTER_RATE_LIMITER",
      "namespace_id": "783421001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "783421002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
