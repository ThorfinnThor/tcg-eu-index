CM_GAMES=magic,yugioh,pokemon,onepiece,dragonballsuper,fleshandblood,digimon,lorcana,starwarsunlimited,riftbound
# Official public URLs are built from the verified Cardmarket game IDs in code.
# These optional overrides exist only for mirrors or local fixtures.
CM_PRICEGUIDE_URL_TEMPLATE=
CM_CATALOGUE_URL_TEMPLATE=
CM_USER_AGENT=tcg-eu-index/1.0 contact=your-email@example.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tcg-raw
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALERT_DISCORD_WEBHOOK=
# Card images stay disabled unless both the global and per-game flag are true.
# Publication policy remains a separate hard gate.
CARD_IMAGES_ENABLED=false
CARD_IMAGES_MAGIC=false
CARD_IMAGES_POKEMON=false
CARD_IMAGES_YUGIOH=false
CARD_IMAGES_ONE_PIECE=false
CARD_IMAGES_DIGIMON=false
CARD_IMAGES_LORCANA=false
CARD_IMAGES_SWU=false
CARD_IMAGES_FAB=false
CARD_IMAGES_DRAGON_BALL=false
CARD_IMAGES_RIFTBOUND=false
CARD_IMAGES_PUBLISH_PROBABLE=false
CARD_IMAGES_ALLOW_STALE_SNAPSHOTS=true
# GitHub repository variables used by archive.yml/audit.yml:
# ARCHIVE_ENABLED=false
# ARCHIVE_INCEPTION_DATE=YYYY-MM-DD
# CM_CONTACT_EMAIL=your-email@example.com
# R2_BUCKET=tcg-raw
NEWSLETTER_ENDPOINT=
NEWSLETTER_API_KEY=
# Cloudflare Workers: set NEWSLETTER_ENDPOINT to a public HTTPS Buttondown-compatible subscriber endpoint.
# Store NEWSLETTER_API_KEY with `wrangler secret put NEWSLETTER_API_KEY`.
